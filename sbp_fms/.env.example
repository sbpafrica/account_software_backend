# ==============================================================================
# SBP Africa Financial Management System (SBP-FMS) - Production Environment Variables
# ==============================================================================

# Core Django Settings
DEBUG=0
SECRET_KEY=generate-a-strong-random-50-char-secret-key-for-production
ALLOWED_HOSTS=api.sbp-africa.com,app.sbp-africa.com

# PostgreSQL Database Configuration
DATABASE_URL=postgres://sbp_user:strong_password@postgres-host:5432/sbp_fms
DB_CONN_MAX_AGE=600

# Redis & Caching
REDIS_URL=redis://redis-host:6379/0

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=https://app.sbp-africa.com,https://finance.sbp-africa.com

# SSL / TLS & Security Headers (Active when DEBUG=0)
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# Celery Configuration
CELERY_BROKER_URL=redis://redis-host:6379/0
CELERY_RESULT_BACKEND=redis://redis-host:6379/0
