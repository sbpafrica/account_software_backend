# ==============================================================================
# SBP-FMS Production Environment Configuration
# Target Host: srv1987570 | Domain: fms.sbpafrica.group
# ==============================================================================

# Core Django Settings
DEBUG=0
SECRET_KEY=sbp_live_secret_key_8fbc2e7a192b490d81c3e5a6439281726a4e9b8c0d1e2f3a4
ALLOWED_HOSTS=fms.sbpafrica.group,127.0.0.1,localhost,api

# PostgreSQL Database (Docker postgres:16-alpine on port 5434 to avoid port conflicts)
POSTGRES_DB=sbp_fms
POSTGRES_USER=sbp_user
POSTGRES_PASSWORD=sbp_secure_prod_password_2026!
POSTGRES_PORT=5434
DATABASE_URL=postgres://sbp_user:sbp_secure_prod_password_2026!@127.0.0.1:5434/sbp_fms
DB_CONN_MAX_AGE=600

# Redis Cache & Message Broker
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=https://fms.sbpafrica.group,http://localhost:3000

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://fms.sbpafrica.group

# SSL / TLS & Security Headers (Active when DEBUG=0)
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1

# Celery Configuration
CELERY_ALWAYS_EAGER=0

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here
PAYSTACK_BASE_URL=https://api.paystack.co

# Mono Open Banking
MONO_SECRET_KEY=sec_live_your_mono_secret_key_here
MONO_PUBLIC_KEY=pub_live_your_mono_public_key_here
MONO_BASE_URL=https://api.withmono.com/v2

# Groq AI Real-Time Foreign Exchange Rates
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
FX_CACHE_TIMEOUT_SECONDS=600
